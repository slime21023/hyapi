{
  "name": "hyapi-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/core",
    "apps/example"
  ],
  "scripts": {
    "build": "bun run --filter hyapi build && bun run --filter @hyapi/example build",
    "dev": "bun run build && bun run --parallel dev:packages dev:example",
    "dev:packages": "bun run --filter hyapi dev",
    "dev:example": "bun --watch apps/example/src/main.ts",
    "start": "bun apps/example/dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 30000 tests/core/public tests/example tests/scripts/internal",
    "test:node": "node --test --test-concurrency=1 --test-timeout=30000 \"tests/core/public/*_test.ts\" \"tests/example/*_test.ts\" \"tests/scripts/internal/*_test.ts\"",
    "verify:consumer": "bun scripts/verify-consumer.ts",
    "publish:check": "bun scripts/packages.ts --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint .",
    "verify": "bun run build && bun run fmt:check && bun run lint && bun run check && bun run test && bun run test:node && bun run verify:consumer && bun run publish:check && bun run docs:build"
  },
  "devDependencies": {
    "@inferdi/inferdi": "6.1.0",
    "@types/bun": "1.3.5",
    "@types/node": "^24.0.0",
    "hyapi": "workspace:*",
    "jose": "6.2.12",
    "oxlint": "1.85.0",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "endOfLine": "lf"
  },
  "patchedDependencies": {
    "vite@5.4.21": "patches/vite@5.4.21.patch",
    "vitepress@1.6.4": "patches/vitepress@1.6.4.patch",
    "@vueuse/core@12.8.2": "patches/@vueuse%2Fcore@12.8.2.patch"
  }
}
