{
  "workspace": ["./packages/core", "./packages/cli", "./apps/example"],
  "imports": {
    "@hyapi/core": "./packages/core/mod.ts",
    "@hono/hono": "jsr:@hono/hono@4",
    "@std/assert": "jsr:@std/assert@1",
    "typebox": "npm:typebox@1",
    "typebox/compile": "npm:typebox@1/compile",
    "typebox/format": "npm:typebox@1/format",
    "typebox/value": "npm:typebox@1/value"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env apps/example/src/main.ts",
    "start": "deno run --allow-net --allow-env apps/example/src/main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno run --allow-read --allow-env --allow-ffi npm:oxlint@1 .",
    "check": "deno check packages/core/mod.ts packages/cli/mod.ts apps/example/src/main.ts packages/core/bench/app_bench.ts scripts/verify-starter.ts",
    "test": "deno test --allow-env --allow-read --allow-write",
    "doctor:example": "deno run --allow-read packages/cli/mod.ts doctor apps/example",
    "verify:starter": "deno run --allow-read --allow-write --allow-run --allow-env scripts/verify-starter.ts",
    "bench": "deno bench --allow-env packages/core/bench/",
    "publish:check": "deno publish --dry-run",
    "verify": "deno fmt --check && deno task lint && deno task check && deno test --allow-env --allow-read --allow-write && deno task doctor:example && deno task verify:starter"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [".agents/"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
