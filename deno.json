{
  "workspace": [
    "./packages/core",
    "./packages/cli",
    "./packages/openapi-diff",
    "./packages/plugin-cors",
    "./packages/plugin-csrf",
    "./packages/plugin-jwt",
    "./packages/plugin-oidc",
    "./packages/plugin-rate-limit",
    "./apps/example"
  ],
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno run --allow-read --allow-env --allow-ffi npm:oxlint@1 --no-error-on-unmatched-pattern .",
    "check": "deno check packages/ apps/ tests/ bench/ scripts/",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 --unstable-no-legacy-abort tests/",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task example:check && deno task docs:build",
    "bench": "deno bench --allow-read bench/",
    "docs:dev": "deno run --node-modules-dir=auto --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --allow-sys vitepress dev docs",
    "docs:build": "deno run --node-modules-dir=auto --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --allow-sys vitepress build docs",
    "docs:preview": "deno run --node-modules-dir=auto --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --allow-sys vitepress preview docs",
    "example:check": "deno task --cwd apps/example emit --check",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "api:update": "deno run --allow-read --allow-write --allow-run tests/architecture/public_api.ts",
    "bench:http": "deno run --allow-net --allow-read --allow-run bench/http/load.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      ".agents/"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "typebox": "npm:typebox@~1.3.34",
    "@seriousme/openapi-schema-validator": "npm:@seriousme/openapi-schema-validator@^2",
    "vitepress": "npm:vitepress@1.6.4",
    "vue": "npm:vue@3.5.43",
    "typescript": "npm:typescript@~5.9.3"
  }
}
