{
  "workspace": ["./packages/core", "./apps/example"],
  "imports": {
    "@hyapi/core": "./packages/core/mod.ts",
    "@hono/hono": "jsr:@hono/hono@4",
    "@std/assert": "jsr:@std/assert@1",
    "typebox": "npm:typebox@1",
    "ajv": "npm:ajv@8"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env apps/example/src/main.ts",
    "start": "deno run --allow-net --allow-env apps/example/src/main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno run --allow-read --allow-env --allow-ffi npm:oxlint@1 .",
    "check": "deno check packages/core/mod.ts apps/example/src/main.ts",
    "test": "deno test --allow-env",
    "verify": "deno fmt --check && deno task lint && deno check packages/core/mod.ts apps/example/src/main.ts && deno test --allow-env"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
