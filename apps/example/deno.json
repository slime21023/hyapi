{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --unstable-no-legacy-abort src/main.ts",
    "start": "deno run --allow-net --allow-env --unstable-no-legacy-abort src/main.ts",
    "emit": "deno run -A ../../packages/cli/mod.ts emit",
    "doctor": "deno run -A ../../packages/cli/mod.ts doctor",
    "diff": "deno run -A ../../packages/cli/mod.ts diff"
  },
  "hyapi": {
    "documents": [
      {
        "name": "internal",
        "api": "./contracts/api.ts#api",
        "openapi": "./openapi.json"
      },
      {
        "name": "public",
        "api": "./contracts/api.ts#publicApi",
        "openapi": "./openapi.public.json"
      }
    ]
  }
}
