{
  "name": "@hyapi/example",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "imports": {
    "@hyapi/core": "../../packages/core/mod.ts",
    "typebox": "npm:typebox@1",
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
