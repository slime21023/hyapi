{
  "imports": {
    "typebox": "npm:typebox@^1",
    "typescript": "npm:typescript@~6.0"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  }
}
