{
  "name": "@hyapi/cli",
  "version": "1.0.0-rc.4",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["**/*_test.ts"]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write mod.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
