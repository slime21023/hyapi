{
  "name": "@hyapi/core",
  "version": "1.0.0-rc.3",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["**/*_test.ts"]
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@4",
    "@std/assert": "jsr:@std/assert@1",
    "typebox": "npm:typebox@1"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
