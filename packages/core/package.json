{
  "name": "hyapi",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@elysia/node": "1.4.6",
    "@elysia/openapi": "1.4.16",
    "@inferdi/inferdi": "6.1.0",
    "@standard-schema/spec": "1.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "elysia": "1.4.30",
    "valibot": "1.5.0"
  }
}
