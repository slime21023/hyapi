{
  "name": "@hyapi/plugin-cors",
  "version": "1.0.0-rc.5",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["**/*_test.ts"]
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
